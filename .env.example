# Default mode uses local demo funds and needs no credentials.
SWIFTPAY_MODE=demo

# Optional: existing SQLite file. Relative paths are resolved from the project root.
# SWIFTPAY_DB_PATH=instance/swiftpay.db

# For Flutterwave test checkout, set SWIFTPAY_MODE=flutterwave-test.
# Use a public HTTPS origin for the browser return and webhook.
# PUBLIC_BASE_URL=https://swiftpay.example.com
FLW_SECRET_KEY=
FLW_SECRET_HASH=
